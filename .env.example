# AIRINDX Frontend Environment Configuration
# Copy this file to .env.local for local overrides.
# NEVER place API secrets, Gemini keys, or private tokens in VITE_* variables.

# Local FastAPI backend base URL during development
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds for backend API calls
VITE_API_TIMEOUT_MS=5000

# Data provider mode: true = local demonstration mock provider, false = FastAPI backend
VITE_USE_MOCK_DATA=true
